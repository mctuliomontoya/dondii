---
import type { Founder } from "../../data/founders";

interface Props {
  founder: Founder;
}
const { founder } = Astro.props;
---

<article class="group flex h-full flex-col items-center rounded-2xl border border-primary-light/60 bg-surface p-8 text-center transition duration-200 hover:-translate-y-1 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/10">
  <div
    class="flex h-20 w-20 items-center justify-center rounded-full bg-primary font-display text-2xl font-black text-paper ring-4 ring-primary-light/50 transition-colors duration-200 group-hover:ring-primary-light"
    aria-hidden="true"
  >
    {founder.initials}
  </div>
  <h3 class="mt-5 font-display text-lg font-bold text-ink">{founder.name}</h3>
  <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-primary">{founder.role}</p>
  <p class="mt-4 leading-relaxed text-ink/70">{founder.bio}</p>
</article>
