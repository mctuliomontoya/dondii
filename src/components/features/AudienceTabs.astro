---
import { segments } from "../../data/segments";
---

<div class="mx-auto max-w-6xl px-6">
  <div
    class="flex flex-wrap gap-2 md:gap-3"
    role="tablist"
    aria-label="Segmentos de Dondii"
  >
    {
      segments.map((segment, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${segment.id}`}
          aria-controls={`panel-${segment.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          data-tab-trigger={segment.id}
          data-active={index === 0 ? "true" : "false"}
          class:list={[
            "tab-trigger inline-flex items-center gap-2 rounded-full border-2 px-4 py-2.5 font-display text-sm font-bold transition-colors duration-200",
            "text-ink hover:border-primary/60",
            "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light",
            "data-[active=true]:border-primary data-[active=true]:bg-primary data-[active=true]:text-paper",
            segment.badge
              ? "border-tomato/60 data-[active=true]:border-primary"
              : "border-primary-light",
          ]}
        >
          {segment.label}
          {segment.badge && (
            <span class="inline-flex items-center gap-1 rounded-full bg-tomato px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-wide text-paper">
              <span class="relative flex h-1.5 w-1.5">
                <span class="absolute inline-flex h-full w-full animate-ping motion-reduce:animate-none rounded-full bg-paper opacity-75" />
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-paper" />
              </span>
              {segment.badge}
            </span>
          )}
        </button>
      ))
    }
  </div>

  <div class="mt-10">
    {
      segments.map((segment, index) => (
        <div
          role="tabpanel"
          id={`panel-${segment.id}`}
          aria-labelledby={`tab-${segment.id}`}
          data-tab-panel={segment.id}
          class="tab-panel"
          hidden={index !== 0}
          tabindex={0}
        >
          <div
            class:list={[
              segment.badge &&
                "rounded-3xl border-2 border-tomato/30 bg-primary-light/15 p-6 md:p-10",
            ]}
          >
            {segment.badge && (
              <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-tomato px-3 py-1 text-xs font-bold uppercase tracking-widest text-paper">
                ✦ {segment.badge} — la única categoría de su tipo en México
              </p>
            )}
            <h2 class="max-w-2xl font-display text-xl font-bold text-ink md:text-2xl">
              {segment.tagline}
            </h2>
            <div class="mt-6 grid gap-6 sm:grid-cols-2">
              {segment.features.map((feature) => (
                <div class="rounded-2xl border border-primary-light/60 bg-surface p-6 transition duration-200 hover:-translate-y-1 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/10">
                  <h3 class="font-display text-lg font-bold text-ink">{feature.title}</h3>
                  <p class="mt-2 leading-relaxed text-ink/70">{feature.body}</p>
                </div>
              ))}
            </div>
            <!-- TODO: reemplazar href del CTA con el link real (waitlist de negocio, descarga, etc.) -->
            <a
              href={segment.cta.href}
              class="mt-8 inline-block rounded-full bg-primary px-6 py-3 font-semibold text-paper transition-colors duration-200 hover:bg-primary-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light"
            >
              {segment.cta.label}
            </a>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  import { revealNow, revealOnScroll } from "../../scripts/motion";

  const tablist = document.querySelector<HTMLElement>('[role="tablist"]');
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-tab-trigger]"),
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>("[data-tab-panel]"),
  );

  function activate(targetId: string): void {
    triggers.forEach((trigger) => {
      const isActive = trigger.dataset.tabTrigger === targetId;
      trigger.dataset.active = String(isActive);
      trigger.setAttribute("aria-selected", String(isActive));
      trigger.tabIndex = isActive ? 0 : -1;
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.tabPanel !== targetId;
    });

    // Click/keyboard driven: animate immediately instead of arming a new
    // ScrollTrigger on every switch (they would stack and never clean up).
    revealNow(`[data-tab-panel="${targetId}"]:not([hidden])`);
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const target = trigger.dataset.tabTrigger;
      if (target) activate(target);
    });
  });

  tablist?.addEventListener("keydown", (event: KeyboardEvent) => {
    const currentIndex = triggers.findIndex(
      (trigger) => trigger === document.activeElement,
    );
    if (currentIndex === -1) return;

    let nextIndex: number | null = null;

    switch (event.key) {
      case "ArrowRight":
      case "ArrowDown":
        nextIndex = (currentIndex + 1) % triggers.length;
        break;
      case "ArrowLeft":
      case "ArrowUp":
        nextIndex = (currentIndex - 1 + triggers.length) % triggers.length;
        break;
      case "Home":
        nextIndex = 0;
        break;
      case "End":
        nextIndex = triggers.length - 1;
        break;
      default:
        return;
    }

    event.preventDefault();
    const nextTrigger = triggers[nextIndex];
    const target = nextTrigger.dataset.tabTrigger;
    nextTrigger.focus();
    if (target) activate(target);
  });

  revealOnScroll(".tab-panel:not([hidden])");
</script>
