---
import DownloadButtons from "../layout/DownloadButtons.astro";
---

<section class="reveal mx-auto flex max-w-6xl flex-col items-center gap-6 border-t border-ink/10 px-6 py-24 text-center md:py-28">
  <h2 class="max-w-2xl font-display text-3xl font-black leading-tight text-ink md:text-4xl">
    Donde la calidad se ve.
  </h2>
  <p class="max-w-xl leading-relaxed text-ink/70">
    Descarga Dondii y descubre por qué Hermosillo ya está comiendo distinto.
  </p>
  <DownloadButtons class="mt-2" />
</section>

<script>
  import { revealOnScroll } from "../../scripts/motion";
  revealOnScroll(".reveal");
</script>
