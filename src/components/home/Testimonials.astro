---
import { testimonials } from "../../data/testimonials";
---

<section class="reveal bg-ink py-24 text-paper md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-primary-light">
      Lo que dicen
    </p>
    <h2 class="mt-3 max-w-2xl font-display text-3xl font-black leading-tight md:text-4xl">
      Todavía no lanzamos. Aquí van las voces reales cuando lleguen.
    </h2>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        testimonials.map((testimonial) => (
          <blockquote class="flex h-full flex-col justify-between rounded-2xl border border-dashed border-paper/20 bg-paper/5 p-6">
            <p class="font-display text-lg italic leading-snug text-paper/90">
              &ldquo;{testimonial.quote}&rdquo;
            </p>
            <footer class="mt-6 text-sm text-paper/60">
              <span class="font-semibold text-paper">{testimonial.author}</span>
              {" · "}
              {testimonial.role}
            </footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { revealOnScroll } from "../../scripts/motion";
  revealOnScroll(".reveal");
</script>
