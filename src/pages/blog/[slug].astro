---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.excerpt}>
  <article class="mx-auto max-w-[70ch] px-6 py-24 md:py-28">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary transition hover:text-primary-dark"
    >
      ← Volver al blog
    </a>

    <div class="mt-8 h-48 rounded-2xl bg-primary-light md:h-64"></div>

    <h1
      class="mt-8 font-display text-3xl font-black leading-tight text-ink md:text-4xl"
    >
      {post.data.title}
    </h1>
    <time
      datetime={post.data.date.toISOString()}
      class="mt-3 block text-sm font-semibold uppercase tracking-widest text-primary"
    >
      {
        post.data.date.toLocaleDateString("es-MX", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      }
    </time>

    <div class="post-body mt-10 leading-relaxed text-ink/80">
      <Content />
    </div>

    <a
      href="/blog"
      class="mt-16 inline-block font-semibold text-primary underline underline-offset-4 hover:text-primary-dark"
    >
      ← Volver al blog
    </a>
  </article>
</Layout>

<style>
  /* Typographic rhythm for the rendered Markdown body. No Tailwind
     typography plugin is installed, so the seed posts' headings, lists
     and blockquote are styled here directly against the brand tokens. */
  .post-body :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .post-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .post-body :global(p) {
    margin-top: 1.25rem;
  }

  .post-body :global(> :first-child) {
    margin-top: 0;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin-top: 1.25rem;
    padding-left: 1.5rem;
  }

  .post-body :global(ul) {
    list-style-type: disc;
  }

  .post-body :global(ol) {
    list-style-type: decimal;
  }

  .post-body :global(li) {
    margin-top: 0.5rem;
  }

  .post-body :global(li)::marker {
    color: var(--color-primary);
  }

  .post-body :global(blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 0;
    border-top: 1px solid rgb(26 19 16 / 0.12);
    border-bottom: 1px solid rgb(26 19 16 / 0.12);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .post-body :global(blockquote p) {
    margin-top: 0;
  }

  .post-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body :global(a:hover) {
    color: var(--color-primary-dark);
  }

  .post-body :global(strong) {
    font-weight: 700;
    color: var(--color-ink);
  }

  .post-body :global(code) {
    border-radius: 0.25rem;
    background-color: rgb(26 19 16 / 0.06);
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
  }
</style>
