---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.excerpt}>
  <article class="mx-auto max-w-[70ch] px-6 py-24 md:py-28">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary transition hover:text-primary-bright"
    >
      ← Volver al blog
    </a>

    <div class="mt-8 h-48 rounded-2xl bg-primary-light md:h-64"></div>

    <h1
      class="mt-8 font-display text-3xl font-normal leading-tight text-ink md:text-4xl"
    >
      {post.data.title}
    </h1>
    <p
      class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-semibold uppercase tracking-widest text-primary"
    >
      <time datetime={post.data.date.toISOString().slice(0, 10)}>
        {
          post.data.date.toLocaleDateString("es-MX", {
            year: "numeric",
            month: "long",
            day: "numeric",
            timeZone: "UTC",
          })
        }
      </time>
      {
        post.data.author && (
          <>
            <span class="text-ink/30" aria-hidden="true">
              ·
            </span>
            <span class="text-ink/60">Por {post.data.author}</span>
          </>
        )
      }
    </p>

    <div class="post-body mt-10 leading-relaxed text-ink/80">
      <Content />
    </div>

    <a
      href="/blog"
      class="mt-16 inline-block font-semibold text-primary underline underline-offset-4 hover:text-primary-bright"
    >
      ← Volver al blog
    </a>
  </article>
</Layout>

<style>
  /* Typographic rhythm for the rendered Markdown body. No Tailwind
     typography plugin is installed, so the seed posts' headings, lists
     and blockquote are styled here directly against the brand tokens. */
  .post-body :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .post-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .post-body :global(p) {
    margin-top: 1.25rem;
  }

  .post-body :global(> :first-child) {
    margin-top: 0;
  }

  /* Listas "· item: descripción" se convierten en tarjetas apiladas,
     no en <li> con viñeta — el término va como kicker en brass para
     que se lea como un mapa de opciones, no como texto plano. */
  .post-body :global(ul) {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-left: 0;
    list-style: none;
  }

  .post-body :global(ol) {
    margin-top: 1.25rem;
    padding-left: 1.5rem;
    list-style-type: decimal;
  }

  .post-body :global(ol li) {
    margin-top: 0.5rem;
  }

  .post-body :global(ol li)::marker {
    color: var(--color-primary);
  }

  .post-body :global(ul li) {
    border: 1px solid rgb(43 26 18 / 0.12);
    border-radius: 4px;
    background-color: var(--color-surface);
    padding: 1rem 1.25rem;
  }

  .post-body :global(ul li strong) {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-impact);
    font-weight: 400;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  /* Diálogo: cada línea con guión largo se convierte en blockquote —
     tratamiento de "voz citada", igual criterio que Testimonials. */
  .post-body :global(blockquote) {
    position: relative;
    overflow: hidden;
    margin: 2rem 0;
    border: 1px solid rgb(138 46 12 / 0.25);
    border-radius: 4px;
    background-color: var(--color-surface);
    padding: 1.5rem 1.75rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .post-body :global(blockquote)::before {
    content: "\201C";
    position: absolute;
    top: -0.3em;
    left: 0.35rem;
    z-index: 0;
    font-family: var(--font-display);
    font-size: 7rem;
    font-style: normal;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.5;
    pointer-events: none;
  }

  .post-body :global(blockquote p) {
    position: relative;
    z-index: 1;
    margin-top: 0;
  }

  /* Firma de cierre: eco tranquilo, no otro párrafo más. */
  .post-body :global(.signoff) {
    margin-top: 2.5rem;
    text-align: right;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.0625rem;
    color: var(--color-primary-bright);
  }

  .post-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body :global(a:hover) {
    color: var(--color-primary-dark);
  }

  .post-body :global(strong) {
    font-weight: 700;
    color: var(--color-ink);
  }

  .post-body :global(code) {
    border-radius: 0.25rem;
    background-color: rgb(26 19 16 / 0.06);
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
  }
</style>
