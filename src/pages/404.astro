---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada" description="Esta página no existe.">
  <section class="mx-auto flex max-w-xl flex-col items-center gap-4 px-6 py-32 text-center">
    <p class="font-display text-6xl font-black text-primary">404</p>
    <h1 class="font-display text-2xl font-black leading-tight text-ink">
      Esta página se perdió, como cuando no encuentras dónde comer.
    </h1>
    <a
      href="/"
      class="font-semibold text-primary underline underline-offset-4 transition-colors duration-200 hover:text-primary-dark"
    >
      Volver al inicio
    </a>
  </section>
</Layout>
