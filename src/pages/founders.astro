---
import Layout from "../layouts/Layout.astro";
import FounderCard from "../components/founders/FounderCard.astro";
import { founders } from "../data/founders";
---

<Layout
  title="Founders"
  description="Conoce al equipo detrás de Dondii — conocemos Hermosillo porque somos de acá."
>
  <section class="reveal relative isolate overflow-hidden bg-paper">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-32 right-[-10%] h-[28rem] w-[28rem] rounded-full bg-primary-light/40 blur-3xl"
    >
    </div>
    <div class="relative mx-auto max-w-3xl px-6 pt-24 pb-4 text-center md:pt-28">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">El equipo</p>
      <h1 class="mt-3 font-display text-4xl font-black leading-tight text-ink md:text-5xl">
        Conocemos Hermosillo porque somos de acá.
      </h1>
      <p class="mx-auto mt-5 max-w-xl leading-relaxed text-ink/70">
        A Dondii no lo construyó una oficina en otra ciudad. Lo construyó
        gente con red dentro de la escena gastronómica de Hermosillo, que
        conoce de primera mano al negocio local — y lo usó como punto de
        partida para diseñar la app.
      </p>
    </div>
  </section>

  <section class="reveal mx-auto max-w-4xl px-6 py-16 md:py-20">
    <div class="grid gap-6 sm:grid-cols-2">
      {founders.map((founder) => <FounderCard founder={founder} />)}
    </div>
  </section>

  <section class="reveal bg-ink py-20 text-paper md:py-24">
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 px-6 text-center">
      <h2 class="font-display text-2xl font-black leading-tight md:text-3xl">
        ¿Quieres sumarte al equipo o platicar sobre Dondii?
      </h2>
      <p class="text-paper/70">
        Escríbenos directo — leemos todos los mensajes.
      </p>
      <!-- TODO: reemplazar href con el mail o link de contacto real -->
      <a
        href="#"
        class="mt-2 inline-flex items-center gap-2 font-display font-bold text-primary-light underline underline-offset-4 transition-colors duration-200 hover:text-paper focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light"
      >
        Escríbenos →
      </a>
    </div>
  </section>
</Layout>

<script>
  import { revealOnScroll } from "../scripts/motion";
  revealOnScroll(".reveal");
</script>
